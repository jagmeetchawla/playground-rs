{
  "productName": "Rustic Playground",
  "version": "0.3.3",
  "identifier": "com.rustic-playground.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "../scripts/sync-version.sh && npm --prefix ../ui run dev",
    "beforeBuildCommand": "../scripts/sync-version.sh && npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rustic Playground",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "exceptionDomain": "",
      "signingIdentity": null,
      "minimumSystemVersion": "11.0"
    }
  }
}
